{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/worker", "src/shared", "src/domain", "cloudflare.config.ts", ".cloudflare/types"],
	"exclude": ["src/**/*.test.ts"]
}
